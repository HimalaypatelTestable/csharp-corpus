<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>OrderKit.Tests</AssemblyName>
    <RootNamespace>OrderKit.Tests</RootNamespace>
    <!-- LangVersion is deliberately NOT set. It defaults from the TargetFramework,
         which is what makes the family axis one number instead of two. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Test runner stack: required for `dotnet test` to discover and run the
         NUnit tests and for the XPlat coverage collector to attach.
         Test.Sdk is pinned to the 16.x generation: its TestHost depends on
         Newtonsoft.Json >= 9.0.1, which keeps the deliberately planted
         Newtonsoft.Json 9.0.1 (PLANTED-CVES.md) intact; 17.x would force a
         downgrade error (NU1605) or an upgrade that erases the planted CVE. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.11.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.2.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="Newtonsoft.Json" Version="9.0.1" />
    <PackageReference Include="System.Net.Http" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.3" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.0" />
    <PackageReference Include="BouncyCastle" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrderKit\OrderKit.csproj" />
  </ItemGroup>

</Project>
